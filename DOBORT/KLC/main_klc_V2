#include "MKL25Z4.h"
#include <stdlib.h>

void LED_init(void);
void LED_set(int rojo, int verde, int azul);
void UART0_init(uint32_t baud);
char UART0_receive_char(void);
void delay_ms(uint32_t ms);

void MOTORES_init(void);
void PWM_init(void);
void motores_avanzar(uint16_t velocidad);
void motores_reversa(uint16_t velocidad);
void motores_detener(void);
void recibir_string_UART0(char *buffer, int longitud);

#define LOOPS_PER_MS  2400UL

typedef enum {
    ESPERANDO_DIRECCION,
    AVANZANDO,
    REVERSA
} EstadoCarrito;

void delay_ms(uint32_t ms) {
    for (uint32_t i = 0; i < ms * LOOPS_PER_MS; i++) {
        __asm volatile ("nop");
    }
}

void LED_init(void) {
    SIM->SCGC5 |= SIM_SCGC5_PORTB_MASK | SIM_SCGC5_PORTD_MASK;
    PORTB->PCR[18] = PORT_PCR_MUX(1); //Rojo
    PORTB->PCR[19] = PORT_PCR_MUX(1); //Verde
    PORTD->PCR[1]  = PORT_PCR_MUX(1); //Azul
    PTB->PDDR |= (1<<18) | (1<<19);
    PTD->PDDR |= (1<<1);
    PTB->PSOR  = (1<<18) | (1<<19);
    PTD->PSOR  = (1<<1);
}

void LED_set(int rojo, int verde, int azul) {
    if (rojo)  PTB->PCOR = (1<<18); else PTB->PSOR = (1<<18);
    if (verde) PTB->PCOR = (1<<19); else PTB->PSOR = (1<<19);
    if (azul)  PTD->PCOR = (1<<1);  else PTD->PSOR = (1<<1);
}

void UART0_init(uint32_t baud) {
    MCG->C4 |= MCG_C4_DMX32_MASK;
    MCG->C4  = (MCG->C4 & ~MCG_C4_DRST_DRS_MASK) | MCG_C4_DRST_DRS(1);
    SIM->CLKDIV1 = SIM_CLKDIV1_OUTDIV1(0) | SIM_CLKDIV1_OUTDIV4(1);
    SIM->SOPT2  |= SIM_SOPT2_UART0SRC(1);
    SIM->SCGC4  |= SIM_SCGC4_UART0_MASK;
    SIM->SCGC5  |= SIM_SCGC5_PORTA_MASK;
    PORTA->PCR[1] = PORT_PCR_MUX(2);
    PORTA->PCR[2] = PORT_PCR_MUX(2);
    UART0->C2 = 0;
    uint16_t sbr = 48000000 / (16 * baud);
    UART0->BDH = (sbr >> 8) & 0x1F;
    UART0->BDL =  sbr & 0xFF;
    UART0->C4  = 0x0F;
    UART0->C1  = 0;
    UART0->C2  = UART0_C2_TE_MASK | UART0_C2_RE_MASK;
}

char UART0_receive_char(void) {
    while (!(UART0->S1 & UART0_S1_RDRF_MASK));
    return UART0->D;
}

void recibir_string_UART0(char *buffer, int longitud) {
    for (int i = 0; i < longitud; i++) {
        buffer[i] = UART0_receive_char();
    }
    buffer[longitud] = '\0';
}

void MOTORES_init(void) {
    SIM->SCGC5 |= SIM_SCGC5_PORTC_MASK;

    //PTC0, PTC1, PTC2 y PTC3
    PORTC->PCR[0] = PORT_PCR_MUX(1); // IN1
    PORTC->PCR[1] = PORT_PCR_MUX(1); // IN2
    PORTC->PCR[2] = PORT_PCR_MUX(1); // IN3
    PORTC->PCR[3] = PORT_PCR_MUX(1); // IN4

    PTC->PDDR |= (1<<0) | (1<<1) | (1<<2) | (1<<3);
    PTC->PCOR = (1<<0) | (1<<1) | (1<<2) | (1<<3);
}

void PWM_init(void) {
    //PTB0 (TPM1_CH0) para ENA y PTB1 (TPM1_CH1) para ENB
    SIM->SCGC5 |= SIM_SCGC5_PORTB_MASK;
    PORTB->PCR[0] = PORT_PCR_MUX(3); // Alternativa 3 es TPM1_CH0
    PORTB->PCR[1] = PORT_PCR_MUX(3); // Alternativa 3 es TPM1_CH1
    SIM->SCGC6 |= SIM_SCGC6_TPM1_MASK;
    SIM->SOPT2 |= SIM_SOPT2_TPMSRC(1);
    TPM1->SC = 0;

    //Edge-Aligned PWM
    TPM1->CONTROLS[0].CnSC = TPM_CnSC_MSB_MASK | TPM_CnSC_ELSB_MASK;
    TPM1->CONTROLS[1].CnSC = TPM_CnSC_MSB_MASK | TPM_CnSC_ELSB_MASK;

    // 48,000,000 / 10,000 = 4800.
    TPM1->MOD = 4800;

    TPM1->CONTROLS[0].CnV = 0;
    TPM1->CONTROLS[1].CnV = 0;

    TPM1->SC = TPM_SC_CMOD(1) | TPM_SC_PS(0);
}

void motores_avanzar(uint16_t velocidad) {
    PTC->PSOR = (1<<0); // IN1 = 1
    PTC->PCOR = (1<<1); // IN2 = 0
    PTC->PSOR = (1<<2); // IN3 = 1
    PTC->PCOR = (1<<3); // IN4 = 0

    TPM1->CONTROLS[0].CnV = velocidad;
    TPM1->CONTROLS[1].CnV = velocidad;
}

void motores_reversa(uint16_t velocidad) {
    PTC->PCOR = (1<<0); // IN1 = 0
    PTC->PSOR = (1<<1); // IN2 = 1
    PTC->PCOR = (1<<2); // IN3 = 0
    PTC->PSOR = (1<<3); // IN4 = 1

    TPM1->CONTROLS[0].CnV = velocidad;
    TPM1->CONTROLS[1].CnV = velocidad;
}

void motores_detener(void) {
    PTC->PCOR = (1<<0) | (1<<1) | (1<<2) | (1<<3);
    TPM1->CONTROLS[0].CnV = 0;
    TPM1->CONTROLS[1].CnV = 0;
}

int main(void) {
    char comando[4];
    int distancia = 0;
    EstadoCarrito estadoActual = ESPERANDO_DIRECCION;
    UART0_init(9600);
    LED_init();
    MOTORES_init();
    PWM_init();

    // 35%(MOD 4800 = 1680)
    uint16_t velocidad_lenta = 1680;

    while (1) {
        switch (estadoActual) {

            case ESPERANDO_DIRECCION:
                LED_set(1, 0, 0); //Rojo
                motores_detener();

                recibir_string_UART0(comando, 3); //Espera KBU o KUB

                if (comando[0] == 'K' && comando[1] == 'U' && comando[2] == 'B') {
                    estadoActual = AVANZANDO;
                }
                else if (comando[0] == 'K' && comando[1] == 'B' && comando[2] == 'U') {
                    estadoActual = REVERSA;
                }
                break;

            case AVANZANDO:
                LED_set(0, 1, 0); //Verde
                motores_avanzar(velocidad_lenta);

                recibir_string_UART0(comando, 3);
                distancia = atoi(comando);

                if (distancia == 0) {
                    motores_detener();
                    estadoActual = ESPERANDO_DIRECCION;
                }
                break;

            case REVERSA:
                LED_set(0, 0, 1); //Azul
                motores_reversa(velocidad_lenta);

                recibir_string_UART0(comando, 3);
                distancia = atoi(comando);

                if (distancia == 0) {
                    motores_detener();
                    estadoActual = ESPERANDO_DIRECCION;
                }
                break;
        }
    }
}
